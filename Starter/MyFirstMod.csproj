<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <PluginFile>$(AssemblyName).dll</PluginFile>
    <PluginFile Condition="'$(Loader)' == 'BepInEx5'">$(AssemblyName).BepInEx5.dll</PluginFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Core" Condition="'$(Loader)' == 'BepInEx6'">
      <HintPath>$(BepInExCore)\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.Mono" Condition="'$(Loader)' == 'BepInEx6'">
      <HintPath>$(BepInExCore)\BepInEx.Unity.Mono.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx" Condition="'$(Loader)' == 'BepInEx5'">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ObenseuerCore">
      <HintPath>$(FrameworkDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckObenseuerSetup" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(ManagedDir)\Assembly-CSharp.dll')" Text="Obenseuer was not found in GameDir '$(GameDir)'. Expected Obenseuer_Data\Managed\Assembly-CSharp.dll. Set the game folder with -p:GameDir=&lt;folder&gt;, the OBENSEUER_DIR environment variable, or GameDir.user.props. See https://github.com/NomadsReach/Obenseuer-Modding-Framework#install" />
    <Error Condition="'$(Loader)' != 'BepInEx5' And '$(Loader)' != 'BepInEx6'" Text="Loader must be BepInEx5 or BepInEx6, not '$(Loader)'." />
    <Error Condition="Exists('$(ManagedDir)\Assembly-CSharp.dll') And (('$(Loader)' == 'BepInEx6' And (!Exists('$(BepInExCore)\BepInEx.Core.dll') Or !Exists('$(BepInExCore)\BepInEx.Unity.Mono.dll'))) Or ('$(Loader)' == 'BepInEx5' And !Exists('$(BepInExCore)\BepInEx.dll')))" Text="BepInEx was not found in '$(BepInExCore)'. Install BepInEx 6 (Unity.Mono, x64, be.755 or newer) or BepInEx 5.4.23 or newer (Mono, x64) in the game folder, start the game once, then build again. For a BepInEx copy elsewhere, pass -p:BepInExCore=&lt;its BepInEx\core folder&gt; and -p:Loader=BepInEx5 for BepInEx 5. See https://github.com/NomadsReach/Obenseuer-Modding-Framework#install" />
    <Error Condition="(Exists('$(BepInExCore)\BepInEx.Core.dll') Or Exists('$(BepInExCore)\BepInEx.dll')) And !Exists('$(FrameworkDll)')" Text="Obenseuer Modding Framework was not found at '$(FrameworkDll)'. Extract the framework zip from https://github.com/NomadsReach/Obenseuer-Modding-Framework/releases into the game folder, then build again. See https://github.com/NomadsReach/Obenseuer-Modding-Framework#install" />
  </Target>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true' And Exists('$(GameDir)\BepInEx\plugins')">
    <MakeDir Directories="$(GameDir)\BepInEx\plugins\$(AssemblyName)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(GameDir)\BepInEx\plugins\$(AssemblyName)\$(PluginFile)" />
  </Target>

</Project>
