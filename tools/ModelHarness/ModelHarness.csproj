<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>ModelHarness</AssemblyName>
    <RootNamespace>ModelHarness</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Loader.cs" Link="Core\Loader.cs" />
    <Compile Include="..\FrameworkModsStub.cs" Link="Core\FrameworkModsStub.cs" />
    <Compile Include="..\..\src\LoaderNamespaces.cs" Link="Core\LoaderNamespaces.cs" />
    <Compile Include="..\..\src\Api\ModIds.cs" Link="Core\ModIds.cs" />
    <Compile Include="..\..\src\Api\ModelObj.cs" Link="Core\ModelObj.cs" />
    <Compile Include="..\..\src\Api\ModelMtl.cs" Link="Core\ModelMtl.cs" />
    <Compile Include="..\..\src\Api\ModelSelfTest.cs" Link="Core\ModelSelfTest.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(Loader)' == 'BepInEx6'">
    <Reference Include="BepInEx.Core">
      <HintPath>$(BepInExCore)\BepInEx.Core.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Unity.Mono">
      <HintPath>$(BepInExCore)\BepInEx.Unity.Mono.dll</HintPath>
    </Reference>
    <Reference Include="SemanticVersioning">
      <HintPath>$(BepInExCore)\SemanticVersioning.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(Loader)' == 'BepInEx5'">
    <PackageReference Include="BepInEx.BaseLib" Version="$(BepInEx5BaseLibVersion)" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    <Reference Include="BepInEx">
      <HintPath>$(PkgBepInEx_BaseLib)/lib/net35/BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)/UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
