<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>NpcHarness</AssemblyName>
    <RootNamespace>NpcHarness</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Loader.cs" Link="Core\Loader.cs" />
    <Compile Include="..\FrameworkModsStub.cs" Link="Core\FrameworkModsStub.cs" />
    <Compile Include="..\..\src\LoaderNamespaces.cs" Link="Core\LoaderNamespaces.cs" />
    <Compile Include="..\..\src\Api\ModIds.cs" Link="Core\ModIds.cs" />
    <Compile Include="..\..\src\Api\ModNpcsSaved.cs" Link="Core\ModNpcsSaved.cs" />
    <Compile Include="..\..\src\Api\ModNpcsSelfTest.cs" Link="Core\ModNpcsSelfTest.cs" />
    <Compile Include="..\..\src\Api\NpcRoutineTable.cs" Link="Core\NpcRoutineTable.cs" />
    <Compile Include="..\..\src\Api\NpcRoutineSelfTest.cs" Link="Core\NpcRoutineSelfTest.cs" />
    <Compile Include="..\..\src\Api\NpcWalkMath.cs" Link="Core\NpcWalkMath.cs" />
    <Compile Include="..\..\src\SaveJson.cs" Link="Core\SaveJson.cs" />
    <Compile Include="..\..\src\Api\SceneLookLivePlan.cs" Link="Core\SceneLookLivePlan.cs" />
    <Compile Include="..\..\src\Api\SceneLookLiveSelfTest.cs" Link="Core\SceneLookLiveSelfTest.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(ManagedDir)/UnityEngine.JSONSerializeModule.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(Loader)' == 'BepInEx6'">
    <Reference Include="BepInEx.Core">
      <HintPath>$(BepInExCore)\BepInEx.Core.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Unity.Mono">
      <HintPath>$(BepInExCore)\BepInEx.Unity.Mono.dll</HintPath>
    </Reference>
    <Reference Include="SemanticVersioning">
      <HintPath>$(BepInExCore)\SemanticVersioning.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(Loader)' == 'BepInEx5'">
    <PackageReference Include="BepInEx.BaseLib" Version="$(BepInEx5BaseLibVersion)" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    <Reference Include="BepInEx">
      <HintPath>$(PkgBepInEx_BaseLib)/lib/net35/BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)/UnityEngine.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
